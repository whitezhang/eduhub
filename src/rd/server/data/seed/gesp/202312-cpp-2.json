      "reference": "#include <stdio.h>\nint main(int argc, char **argv)\n{\n    int n, i, j;\n    scanf(\"%d\", &n);\n    for(i=1; i<=(n+1)/2-1; i++)\n    {\n        printf(\"|\");\n        for(j=2; j<=n-1; j++)\n        {\n            printf(\"a\");\n        }\n        printf(\"|\\n\");\n    }\n    printf(\"|\");\n    for(j=2; j<=n-1; j++)\n    {\n        printf(\"-\");\n    }\n    printf(\"|\\n\");\n    for(i=(n+1)/2+1; i<=n; i++)\n    {\n        printf(\"|\");\n        for(j=2; j<=n-1; j++)\n        {\n            printf(\"a\");\n        }\n        printf(\"|\\n\");\n    }\n    return 0;\n}"
