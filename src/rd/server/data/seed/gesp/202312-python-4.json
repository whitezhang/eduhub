      "reference": "n = int(input())\nd = {}\nfor i in range(n):\n    k, v = input().split(' ')\n    assert k not in d\n    d[k] = v\npunc = '!()-[]{}\\|;:\\'\",./?<>'\nUNK = \"UNK\"\nst = input()\ncurr_token = \"\"\nans = \"\"\nfor ch in st:\n    if ch in punc:\n        if curr_token in d:\n            ans += d[curr_token]\n        elif curr_token:\n            ans += UNK\n        curr_token = \"\"\n        ans += ch\n    else:\n        assert ch.islower()\n        curr_token += ch\nif curr_token in d:\n    ans += d[curr_token]\nelif curr_token:\n    ans += UNK\nprint(ans)"
