      "seq": 2,
      "kind": "traditional",
      "title": "纸牌游戏",
      "statement": "时间限制: 1.0 s\n内存限制: 128.0 MB\nconst int max_n = 1e5 + 10;\nint n;\nvector<int> edge[max_n];\nint val[max_n];\nint min_dist[max_n];\nint queue[max_n], qh, qt;\nvoid bfs(int src) {\n    qh = qt = 0;\n    memset(min_dist, 127, sizeof(min_dist));\n    queue[++qt] = src;\n    min_dist[src] = 0;\n    while (qh < qt) {\n        int u = queue[++qh];\n        for (auto v: edge[u]) {\n            if (min_dist[u] + 1 < min_dist[v]) {\n                min_dist[v] = min_dist[u] + 1;\n                queue[++qt] = v;\n            }\n        }\n    }\n}",
