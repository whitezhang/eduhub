      "has_ref": true,
      "reference": "#include <stdio.h>\nint main(int argc, char **argv)\n{\n    int n, m, i;\n    scanf(\"%d%d\", &n, &m);\n    for(i=1; i<=n; i++)\n    {\n        if(i%m!=0) printf(\"%d\\n\", i);\n    }\n    return 0;\n}"
