      "has_ref": true,
      "reference": "#include <bits/stdc++.h>\nusing namespace std;\nint main() {\n    int n, x, y, ans;\n    cin >> n >> x >> y;\n    assert(1 <= n && n <= 1000 && 1 <= x && x <= 1000 && 1 <= y && y <= 1000);\n    ans = n - y / x - 1 + (y % x == 0);\n    assert(ans >= 1);\n    cout << ans << '\\n';\n\n    return 0;\n}"
