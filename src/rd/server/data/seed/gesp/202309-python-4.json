      "has_ref": true,
      "reference": "n = int(input())\nfor i in range(n):\n    k, st = input().strip().split(' ')\n    k = int(k)\n    ans = 0\n    for j, ch in enumerate(reversed(st)):\n        if ch <= '9':\n            bit = ord(ch) - ord('0')\n        else:\n            bit = ord(ch) - ord('A') + 10\n        ans += bit * (k ** j)\n    print(ans)"
    },
