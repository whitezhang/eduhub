      "has_ref": true,
      "reference": "#include<bits/stdc++.h>\nusing namespace std;\nconst int N = 1010;\nint a[N];\nint n,k;\nint main(){\n    cin>>n>>k;\n    for(int i=1;i<=n;i++){\n        cin>>a[i];\n    }\n    sort(a+1,a+n+1);\n    int ans=0;\n    for(int i=1;i<=n;i++){\n        int sum=0;\n        for(int j=i;j>=1;j--){\n            if(a[i]-a[j]<=k){\n                sum+=a[j];\n            }else break;\n        }\n        ans=max(ans,sum);\n    }\n    cout<<ans<<\"\\n\";\n}"
